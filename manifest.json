{
    "manifest_version": 3,
    "name": "Audio Focus",
    "version": "1.1",
    "description": "Auto mute other tabs when one plays audio",
    "permissions": [
        "tabs",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    }
}